# Track only the maintained source tree, not the historical research workspace.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY_NOTICES.md
!/build.cmd
!/src/
!/include/
!/profiles/
!/tests/
!/tools/
!/config/
!/vendor/

**/__pycache__/
*.py[cod]
*.obj
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.log
*.pcm
*.wav
*.sd9
*.ifs
*.mp4
*.local.*
config/daily24.ini
vendor/*
!vendor/minhook/
!vendor/spicesdk/
vendor/minhook/*
!vendor/minhook/include/
!vendor/minhook/src/
!vendor/minhook/LICENSE.txt
!vendor/minhook/AUTHORS.txt
